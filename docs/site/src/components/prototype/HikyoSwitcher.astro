---
import { prototypes } from '../../lib/prototype/hikyo';
import PostHog from '../posthog.astro';

interface Props {
  current: number;
}

const { current } = Astro.props;
const total = prototypes.length;
---

<nav class="proto-switch" aria-label="Prototype switcher">
  <button class="proto-switch-toggle" type="button" aria-expanded="false" aria-controls="proto-switch-list">
    {current} / {total}
  </button>
  <div class="proto-switch-list" id="proto-switch-list">
    <a class="proto-switch-home" href="/prototype/hikyo/">prototype</a>
    {
      prototypes.map((p) => (
        <a
          href={`/prototype/hikyo/${p.n}/`}
          aria-current={p.n === current ? 'page' : undefined}
          aria-label={`Prototype ${p.n}: ${p.name}`}
          title={p.name}
        >
          {p.n}
        </a>
      ))
    }
  </div>
</nav>
<PostHog />

<script>
  const nav = document.querySelector('.proto-switch');
  const toggle = nav?.querySelector('.proto-switch-toggle');
  if (nav instanceof HTMLElement && toggle instanceof HTMLButtonElement) {
    nav.classList.add('js');
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }
</script>

<style>
  .proto-switch {
    position: fixed;
    z-index: 1000;
    inset-block-end: max(0.75rem, env(safe-area-inset-bottom));
    inset-inline-end: 0.75rem;
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-end;
    gap: 0.5rem;
    color: oklch(0.93 0.008 200);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.8125rem;
    line-height: 1;
  }
  .proto-switch-list {
    display: flex;
    align-items: stretch;
    border: 1px solid oklch(0.5 0.016 220);
    border-radius: 6px;
    background: oklch(0.19 0.012 220);
    box-shadow: 0 8px 24px oklch(0 0 0 / 0.35);
  }
  .proto-switch a {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: none;
    border-inline-start: 1px solid oklch(0.3488 0.01488 220);
  }
  .proto-switch a:hover {
    background: oklch(0.27 0.016 220);
  }
  .proto-switch a[aria-current='page'] {
    background: oklch(0.82 0.09 195);
    color: oklch(0.2 0.02 220);
    font-weight: 700;
  }
  .proto-switch-home {
    padding-inline: 0.75rem;
    border-inline-start: 0 !important;
    color: oklch(0.76 0.01 210) !important;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.6875rem;
  }
  .proto-switch a:focus-visible,
  .proto-switch-toggle:focus-visible {
    outline: 2px solid oklch(0.82 0.09 195);
    outline-offset: -3px;
  }
  .proto-switch-toggle {
    display: none;
    min-width: 4.5rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid oklch(0.5 0.016 220);
    border-radius: 6px;
    background: oklch(0.19 0.012 220);
    color: inherit;
    font: inherit;
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow: 0 8px 24px oklch(0 0 0 / 0.35);
    cursor: pointer;
  }
  @media (max-width: 40rem) {
    .proto-switch {
      inset-inline-end: 0.5rem;
      inset-block-end: max(0.5rem, env(safe-area-inset-bottom));
    }
    .proto-switch.js .proto-switch-toggle {
      display: block;
    }
    .proto-switch.js:not(.open) .proto-switch-list {
      display: none;
    }
    .proto-switch-list {
      display: grid;
      grid-template-columns: repeat(6, 2.75rem);
    }
    .proto-switch a {
      border-inline-start: 0;
      border-block-start: 1px solid oklch(0.3488 0.01488 220);
    }
    .proto-switch-home {
      grid-column: 1 / -1;
      border-block-start: 0 !important;
      min-height: 2rem;
    }
  }
</style>
