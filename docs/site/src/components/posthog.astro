---
import PostHogConsent from './PostHogConsent.astro';

const apiKey = import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN;
const apiHost = import.meta.env.PUBLIC_POSTHOG_HOST;
const postHogRequired = import.meta.env.POSTHOG_REQUIRED === 'true';

if (postHogRequired && !apiKey) {
  throw new Error('PUBLIC_POSTHOG_PROJECT_TOKEN is required to build the Hikyo site');
}

if (postHogRequired && !apiHost) {
  throw new Error('PUBLIC_POSTHOG_HOST is required to build the Hikyo site');
}

const postHogEnabled = Boolean(apiKey && apiHost);
---

{postHogEnabled && <PostHogConsent apiKey={apiKey} apiHost={apiHost} />}
