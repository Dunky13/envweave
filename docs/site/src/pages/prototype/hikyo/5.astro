    <script>
      // Marks events as they enter the viewport. Without JS everything is
      // already visible; the .js class only opts the log into the transition.
      const logs = document.querySelectorAll<HTMLElement>('.log');
      const events = document.querySelectorAll<HTMLElement>('.event');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) {
        events.forEach((el) => el.classList.add('seen'));
      } else {
        logs.forEach((el) => el.classList.add('js'));
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('seen');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );
        events.forEach((el) => io.observe(el));
      }
    </script>
