---
// Prototype 5 · Audit trail. The homepage reads as an append-only log: every
// marketing section is an event on a vertical spine. Product claims come from
// src/lib/prototype/hikyo.ts and the shipped docs; event names, offsets, the
// refusal record and the reveal steps are illustrative shapes, not captured output.
import '@fontsource-variable/familjen-grotesk/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import HikyoHead from '../../../components/prototype/HikyoHead.astro';
import HikyoSwitcher from '../../../components/prototype/HikyoSwitcher.astro';
import {
  claims,
  cli,
  cellLabel,
  cellText,
  cliReferenceUrl,
  coreConceptsUrl,
  docsUrl,
  environments,
  gettingStartedUrl,
  keyCount,
  masked,
  matrix,
  project,
  repositoryUrl,
  selfHostingUrl,
} from '../../../lib/prototype/hikyo';
import type { CellState, Environment, KeyGroup } from '../../../lib/prototype/hikyo';

type Outcome = 'allowed' | 'refused' | 'recorded';

interface LogLine {
  seq: string;
  offset: string;
  name: string;
  actor: string;
  scope: string;
  outcome: Outcome;
}

const projectScope = `${project.organisation}/${project.name}`;

// One trail, monotonic offsets. Relative to the first line, never a wall clock.
const ev: Record<
  'declared' | 'setStaging' | 'refused' | 'published' | 'revealed' | 'deliveryRefused' | 'deliveryStarted' | 'instance',
  LogLine
> = {
  declared: {
    seq: '#0001',
    offset: '+00:00.000',
    name: 'key.declared',
    actor: 'operator',
    scope: projectScope,
    outcome: 'allowed',
  },
  setStaging: {
    seq: '#0002',
    offset: '+00:04.120',
    name: 'value.set',
    actor: 'operator',
    scope: `${projectScope}/staging`,
    outcome: 'allowed',
  },
  refused: {
    seq: '#0003',
    offset: '+00:09.470',
    name: 'publish.refused',
    actor: 'ci-runner',
    scope: `${projectScope}/production`,
    outcome: 'refused',
  },
  published: {
    seq: '#0004',
    offset: '+00:12.960',
    name: 'publish.completed',
    actor: 'operator',
    scope: `${projectScope}/production`,
    outcome: 'allowed',
  },
  revealed: {
    seq: '#0005',
    offset: '+00:31.008',
    name: 'secret.revealed',
    actor: 'operator',
    scope: `${projectScope}/production`,
    outcome: 'allowed',
  },
  deliveryRefused: {
    seq: '#0006',
    offset: '+00:47.215',
    name: 'delivery.refused',
    actor: 'payments-api (service account)',
    scope: `${projectScope}/production`,
    outcome: 'refused',
  },
  deliveryStarted: {
    seq: '#0007',
    offset: '+00:52.640',
    name: 'delivery.started',
    actor: 'payments-api (service account)',
    scope: `${projectScope}/production`,
    outcome: 'allowed',
  },
  instance: {
    seq: '#0008',
    offset: '+01:10.002',
    name: 'instance.started',
    actor: 'system',
    scope: 'hikyo.example.com',
    outcome: 'recorded',
  },
};

// The lead-in write that #0004 publishes. Shown as decision context, not as a
// numbered line, so the trail keeps the eight events the page is built around.
const setProductionOffset = '+00:12.310';

const webhookName = 'STRIPE_WEBHOOK_SECRET';
const webhook = matrix.flatMap((group) => group.keys).find((key) => key.name === webhookName);
if (!webhook) throw new Error(`${webhookName} is missing from the shared matrix`);

// Row states as the trail produces them. The shared dataset holds the final
// pre-publish state (production still missing); the earlier two are derived.
const rowAfterDeclare: Record<Environment, CellState> = {
  development: { kind: 'absent' },
  staging: { kind: 'missing' },
  production: { kind: 'missing' },
};
const rowAfterStaging: Record<Environment, CellState> = {
  development: { kind: 'absent' },
  staging: { kind: 'secret' },
  production: { kind: 'missing' },
};
const rowAfterPublish: Record<Environment, CellState> = {
  development: { kind: 'absent' },
  staging: { kind: 'secret' },
  production: { kind: 'secret' },
};

// State-after-publish snapshot: the shared matrix, with the one row this trail
// changed advanced to its post-publish state. Everything else is untouched,
// including the open draft in production and the SMTP violation in staging.
const snapshot: KeyGroup[] = matrix.map((group) => ({
  ...group,
  keys: group.keys.map((key) => (key.name === webhookName ? { ...key, cells: rowAfterPublish } : key)),
}));
const groupCount = snapshot.length;
const allOrNoneGroups = snapshot.filter((group) => group.allOrNone).map((group) => group.name);

const isProtected = (env: Environment): boolean => project.protectedEnvironments.some((p) => p === env);

const cliSetStaging = cli.set.replace('payments/production', 'payments/staging');

const ledger: { key: string; value: string }[] = [
  { key: 'runtime', value: claims.runtime },
  { key: 'storage', value: 'SQLite or PostgreSQL' },
  { key: 'encryption', value: 'envelope encryption, operator-held root key material' },
  { key: 'identity', value: claims.identity.join(' · ') },
  { key: 'surfaces', value: claims.surfaces.join(' · ') },
  { key: 'delivery', value: claims.delivery.join(' · ') },
  { key: 'imports', value: claims.imports.join(' · ') },
  { key: 'lifecycle', value: claims.lifecycle.join(' · ') },
  { key: 'audit', value: 'append-only; actor, object, outcome, decision context; never secret material' },
  { key: 'scanning', value: claims.scanning },
  { key: 'license', value: claims.license },
  { key: 'source', value: 'fully open source, no /ee directory' },
  { key: 'maturity', value: '0.x, pre-1.0' },
];

const title = 'Hikyo · Every change leaves a line';
const description =
  'Hikyo is an open-source, self-hosted control plane for explicit secrets and configuration with an append-only audit trail.';
---

<!doctype html>
<html lang="en">
  <head>
    <HikyoHead title={title} description={description} themeColor="#1a1d24" />
  </head>
  <body>
    <a class="skip" href="#trail">Skip to the trail</a>

    <header class="masthead rail">
      <a class="wordmark" href="/prototype/hikyo/5/" aria-label="Hikyo home">
        <img src="/favicon.svg" alt="" width="22" height="22" />
        <span>hikyo</span>
      </a>
      <nav class="nav" aria-label="Primary">
        <a href={docsUrl}>Docs</a>
        <a href={repositoryUrl} rel="noopener">GitHub</a>
      </nav>
      <p class="proto-mark">Prototype 5 · Audit trail</p>
    </header>

    <main id="main">
      <section class="hero rail" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <p class="eyebrow">Open-source, self-hosted control plane for secrets and configuration</p>
          <h1 id="hero-heading">Every change leaves a line.</h1>
          <p class="lede">
            Explicit values, deliberate disclosure, and an append-only trail that records the decision, never the
            secret.
          </p>
          <div class="actions">
            <a class="btn primary" href={repositoryUrl} rel="noopener">View on GitHub</a>
            <a class="btn" href={docsUrl}>Read the docs</a>
          </div>
        </div>
        <div class="legend" role="group" aria-labelledby="legend-heading">
          <p id="legend-heading" class="legend-title">How to read this page</p>
          <p class="legend-line">
            <span class="f seq">#seq</span>
            <span class="f name">event.name</span>
            <span class="meta">
              <span class="f off">+offset</span>
              <span class="f actor">actor</span>
              <span class="f scope">org/project/environment</span>
              <span class="f out">outcome</span>
            </span>
          </p>
          <p class="legend-note">
            One trail, one example project. Offsets are relative to the first line. Outcomes are always a word:
            <span class="w allowed">allowed</span>, <span class="w refused">refused</span>,
            <span class="w recorded">recorded</span>. No line ever contains a secret value.
          </p>
        </div>
      </section>

      <ol class="log" id="trail" aria-label="Audit trail, events 1 to 4">
        <!-- #0001 key.declared -->
        <li class="event" id="e0001">
          <div class="spine">
            <span class="marker" aria-hidden="true"></span>
            <span class="idx" aria-hidden="true">01</span>
          </div>
          <p class="line">
            <span class="f seq">{ev.declared.seq}</span>
            <span class="f name">{ev.declared.name}</span>
            <span class="meta">
              <span class="f off">{ev.declared.offset}</span>
              <span class="f actor">{ev.declared.actor}</span>
              <span class="f scope">{ev.declared.scope}</span>
              <span class={`f out ${ev.declared.outcome}`}>{ev.declared.outcome}</span>
            </span>
          </p>
          <dl class="ctx">
            <div><dt>key</dt><dd>{webhook.name}</dd></div>
            <div><dt>classification</dt><dd>{webhook.classification}</dd></div>
            <div><dt>presence</dt><dd>{webhook.presence}</dd></div>
          </dl>
          <div class="copy">
            <h2>A key exists before any value does.</h2>
            <p>
              The declaration comes first: a name, a classification of config or secret, a validation rule, and a
              presence rule per environment. Until a value is set, each environment records absence explicitly.
              Development may stay absent. Staging and production are required, so their empty cells are violations
              and are named as such.
            </p>
            <p>
              No environment inherits from another. An empty cell never means inherited, unknown, or default; it means
              absent, here, on purpose or not yet.
            </p>
          </div>
          <div class="artifact">
            <p class="art-title">Declaration</p>
            <dl class="decl">
              <div><dt>name</dt><dd>{webhook.name}</dd></div>
              <div><dt>classification</dt><dd>{webhook.classification}</dd></div>
              <div><dt>rule</dt><dd>{webhook.rule}</dd></div>
              <div><dt>presence</dt><dd>{webhook.presence}</dd></div>
            </dl>
            <pre class="code"><code>{cli.declare}</code></pre>
            <p class="art-title">Resulting row</p>
            <div class="scroll">
              <table class="row-table">
                <caption class="sr-only">STRIPE_WEBHOOK_SECRET after declaration, one cell per environment</caption>
                <thead>
                  <tr>
                    <th scope="col">key</th>
                    {environments.map((env) => <th scope="col">{env}</th>)}
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th scope="row" class="key">
                      <svg class="lock" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="M3.5 5V3.5a2.5 2.5 0 0 1 5 0V5" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="2" y="5" width="8" height="6" rx="0.5" fill="currentColor"/></svg>
                      <span class="sr-only">secret key </span>{webhook.name}
                    </th>
                    {environments.map((env) => (
                      <td class={`cell ${rowAfterDeclare[env].kind}`}>
                        <span aria-hidden="true">{cellText(rowAfterDeclare[env])}</span>
                        <span class="sr-only">{cellLabel(rowAfterDeclare[env])}</span>
                      </td>
                    ))}
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </li>

        <!-- #0002 value.set, staging -->
        <li class="event" id="e0002">
          <div class="spine">
            <span class="marker" aria-hidden="true"></span>
            <span class="idx" aria-hidden="true">02</span>
          </div>
          <p class="line">
            <span class="f seq">{ev.setStaging.seq}</span>
            <span class="f name">{ev.setStaging.name}</span>
            <span class="meta">
              <span class="f off">{ev.setStaging.offset}</span>
              <span class="f actor">{ev.setStaging.actor}</span>
              <span class="f scope">{ev.setStaging.scope}</span>
              <span class={`f out ${ev.setStaging.outcome}`}>{ev.setStaging.outcome}</span>
            </span>
          </p>
          <dl class="ctx">
            <div><dt>key</dt><dd>{webhook.name}</dd></div>
            <div><dt>source</dt><dd>--value-file</dd></div>
            <div><dt>rule</dt><dd>pattern matched</dd></div>
            <div><dt>material_recorded</dt><dd>never</dd></div>
          </dl>
          <div class="copy">
            <h2>A value is set from a file, not from an argument.</h2>
            <p>
              The file is read locally, so the value never passes through shell history or a process list. The write
              is validated against the declared rule before any state changes. Staging now records a secret: masked in
              the matrix, a lock on the key, presence and metadata on ordinary reads.
            </p>
          </div>
          <div class="artifact">
            <pre class="code"><code>{cliSetStaging}</code></pre>
            <p class="art-title">Row after the write</p>
            <div class="scroll">
              <table class="row-table">
                <caption class="sr-only">STRIPE_WEBHOOK_SECRET after the staging write</caption>
                <thead>
                  <tr>
                    <th scope="col">key</th>
                    {environments.map((env) => <th scope="col">{env}</th>)}
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th scope="row" class="key">
                      <svg class="lock" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="M3.5 5V3.5a2.5 2.5 0 0 1 5 0V5" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="2" y="5" width="8" height="6" rx="0.5" fill="currentColor"/></svg>
                      <span class="sr-only">secret key </span>{webhook.name}
                    </th>
                    {environments.map((env) => (
                      <td class={`cell ${rowAfterStaging[env].kind}`}>
                        <span aria-hidden="true">{cellText(rowAfterStaging[env])}</span>
                        <span class="sr-only">{cellLabel(rowAfterStaging[env])}</span>
                      </td>
                    ))}
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </li>

        <!-- #0003 publish.refused, production -->
        <li class="event" id="e0003">
          <div class="spine">
            <span class="marker" aria-hidden="true"></span>
            <span class="idx" aria-hidden="true">03</span>
          </div>
          <p class="line">
            <span class="f seq">{ev.refused.seq}</span>
            <span class="f name">{ev.refused.name}</span>
            <span class="meta">
              <span class="f off">{ev.refused.offset}</span>
              <span class="f actor">{ev.refused.actor}</span>
              <span class="f scope">{ev.refused.scope}</span>
              <span class={`f out ${ev.refused.outcome}`}>{ev.refused.outcome}</span>
            </span>
          </p>
          <dl class="ctx">
            <div><dt>reason</dt><dd>required key absent</dd></div>
            <div><dt>key</dt><dd>{webhook.name}</dd></div>
            <div><dt>state_changed</dt><dd>false</dd></div>
          </dl>
          <div class="copy">
            <h2>Production refuses to publish with a required key absent.</h2>
            <p>
              The refusal names the key, the rule that applies, and the next safe action. Nothing about production
              changed; the line records that a change was attempted and why it did not happen.
            </p>
            <p>
              The same rules hold at write time. An invalid value is refused before state changes. A required value
              cannot be cleared where its rule applies: clear records absent, and absent is not allowed here.
            </p>
          </div>
          <div class="artifact">
            <div class="refusal" role="group" aria-label="Refusal record">
              <p class="refusal-head"><span class="w refused">refused</span> publish · production</p>
              <p class="refusal-body">1 required key is absent in production.</p>
              <div class="scroll">
                <table class="row-table">
                  <caption class="sr-only">Violations that blocked the publish</caption>
                  <thead>
                    <tr>
                      <th scope="col">key</th>
                      <th scope="col">production</th>
                      <th scope="col">presence rule</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <th scope="row" class="key">
                        <svg class="lock" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="M3.5 5V3.5a2.5 2.5 0 0 1 5 0V5" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="2" y="5" width="8" height="6" rx="0.5" fill="currentColor"/></svg>
                        <span class="sr-only">secret key </span>{webhook.name}
                      </th>
                      <td class="cell missing">
                        <span aria-hidden="true">{cellText(rowAfterStaging.production)}</span>
                        <span class="sr-only">{cellLabel(rowAfterStaging.production)}</span>
                      </td>
                      <td class="cell">{webhook.presence}</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <p class="refusal-next">next</p>
              <pre class="code"><code>{cli.set}</code></pre>
              <p class="refusal-foot">exit status 4 · refused · satisfy the named condition, then retry</p>
            </div>
          </div>
        </li>

        <!-- #0004 publish.completed, production, wide artifact -->
        <li class="event wide" id="e0004">
          <div class="spine">
            <span class="marker" aria-hidden="true"></span>
            <span class="idx" aria-hidden="true">04</span>
          </div>
          <p class="line">
            <span class="f seq">{ev.published.seq}</span>
            <span class="f name">{ev.published.name}</span>
            <span class="meta">
              <span class="f off">{ev.published.offset}</span>
              <span class="f actor">{ev.published.actor}</span>
              <span class="f scope">{ev.published.scope}</span>
              <span class={`f out ${ev.published.outcome}`}>{ev.published.outcome}</span>
            </span>
          </p>
          <dl class="ctx">
            <div><dt>preceded_by</dt><dd>value.set {setProductionOffset} allowed</dd></div>
            <div><dt>protected</dt><dd>true</dd></div>
            <div><dt>confirmation</dt><dd>explicit</dd></div>
            <div><dt>reauthenticated</dt><dd>true</dd></div>
            <div><dt>revision</dt><dd>{project.revision}</dd></div>
          </dl>
          <div class="copy">
            <h2>Production is protected, so the change costs a ceremony.</h2>
            <p>
              Writing into a protected environment takes explicit confirmation and the matching authorization, and a
              protected environment never keeps a reauthentication window open. The trail records the ceremony and its
              outcome. It does not record the value that was published.
            </p>
            <p>
              Below is the matrix after the publish: {keyCount} keys in {groupCount} groups across three environments.
              It hides nothing that is still open. One draft remains unpublished in production (Δ 40 on
              DATABASE_POOL_MAX) and one violation remains in staging: SMTP_PASSWORD is absent inside the
              all-or-none group <span class="mono">{allOrNoneGroups.join(', ')}</span>.
            </p>
          </div>
          <div class="artifact">
            <p class="art-title">State after publish · {project.organisation}/{project.name} · {project.revision}</p>
            <div class="scroll">
              <table class="matrix">
                <caption class="sr-only">
                  Environment matrix for {project.name}: {keyCount} keys in {groupCount} groups across development,
                  staging, and production
                </caption>
                <thead>
                  <tr>
                    <th scope="col">key</th>
                    {environments.map((env) => (
                      <th scope="col">
                        {env}
                        {isProtected(env) && <span class="prot"> · protected</span>}
                      </th>
                    ))}
                  </tr>
                </thead>
                {snapshot.map((group) => (
                  <tbody>
                    <tr class="group">
                      <th scope="colgroup" colspan={environments.length + 1}>
                        {group.name}
                        <span class="group-meta">
                          {' '}· {group.keys.length} {group.keys.length === 1 ? 'key' : 'keys'}
                          {group.allOrNone && ' · all-or-none group'}
                        </span>
                      </th>
                    </tr>
                    {group.keys.map((key) => (
                      <tr>
                        <th scope="row" class="key">
                          {key.classification === 'secret' && (
                            <>
                              <svg class="lock" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="M3.5 5V3.5a2.5 2.5 0 0 1 5 0V5" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="2" y="5" width="8" height="6" rx="0.5" fill="currentColor"/></svg>
                              <span class="sr-only">secret key </span>
                            </>
                          )}
                          {key.name}
                        </th>
                        {environments.map((env) => (
                          <td class={`cell ${key.cells[env].kind}`}>
                            <span aria-hidden="true">{cellText(key.cells[env])}</span>
                            <span class="sr-only">{cellLabel(key.cells[env])}</span>
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                ))}
              </table>
            </div>
            <p class="matrix-legend" aria-label="State legend">
              <span>{masked} secret set, masked</span>
              <span>· absent</span>
              <span class="w refused">! required · absent</span>
              <span class="w draft">Δ draft, unpublished</span>
              <span>· absent (forbidden)</span>
            </p>
          </div>
        </li>
      </ol>

      <!-- Interlude: the five pillars as a ledger. Breaks the spine on purpose. -->
      <section class="interlude rail" aria-labelledby="pillars-heading">
        <div class="interlude-inner">
          <p class="eyebrow" id="pillars-heading">What the trail is evidence of</p>
          <ol class="pillars">
            {claims.pillars.map((pillar, i) => (
              <li>
                <span class="pillar-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h2>{pillar.title}</h2>
                <p>{pillar.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <ol class="log" start="5" aria-label="Audit trail, events 5 to 8">
        <!-- #0005 secret.revealed -->
        <li class="event" id="e0005">
          <div class="spine">
            <span class="marker" aria-hidden="true"></span>
            <span class="idx" aria-hidden="true">05</span>
          </div>
          <p class="line">
            <span class="f seq">{ev.revealed.seq}</span>
            <span class="f name">{ev.revealed.name}</span>
            <span class="meta">
              <span class="f off">{ev.revealed.offset}</span>
              <span class="f actor">{ev.revealed.actor}</span>
              <span class="f scope">{ev.revealed.scope}</span>
              <span class={`f out ${ev.revealed.outcome}`}>{ev.revealed.outcome}</span>
            </span>
          </p>
          <dl class="ctx">
            <div><dt>key</dt><dd>{webhook.name}</dd></div>
            <div><dt>reauthenticated</dt><dd>true</dd></div>
            <div><dt>remask</dt><dd>automatic</dd></div>
            <div><dt>material_recorded</dt><dd>never</dd></div>
          </dl>
          <div class="copy">
            <h2>Reading a secret is a separate act with its own line.</h2>
            <p>
              Ordinary reads return presence and metadata only; that is enough for inventory and health checks. A
              reveal is a ceremony: it requires reauthentication over the environment, writes to a file that must not
              already exist, remasks automatically, and records its own event.
            </p>
            <p>Replacing a secret never needs the old plaintext. Set the new value; the old one is never shown.</p>
          </div>
          <div class="artifact">
            <p class="art-title">Ordinary read</p>
            <pre class="code"><code>{cli.get}</code></pre>
            <pre class="code out"><code>{cli.getMasked}</code></pre>
            <p class="art-title">Reveal, to a new file</p>
            <pre class="code"><code>{cli.reveal}</code></pre>
            <ol class="steps" aria-label="Reveal ceremony">
              <li><span class="step-n" aria-hidden="true">1</span> reauthentication window checked: none live for production</li>
              <li><span class="step-n" aria-hidden="true">2</span> purpose-bound ceremony opened, naming exactly {webhook.name}</li>
              <li><span class="step-n" aria-hidden="true">3</span> approved; session token rotated</li>
              <li><span class="step-n" aria-hidden="true">4</span> plaintext written to ./whsec, which did not exist</li>
              <li><span class="step-n" aria-hidden="true">5</span> terminal and matrix remain masked: {masked}</li>
              <li><span class="step-n" aria-hidden="true">6</span> event {ev.revealed.seq} appended: actor, key, outcome, no value</li>
